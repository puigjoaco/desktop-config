<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Clipboard Panel</vendor>
  <action id="org.local.clipboard-panel.change-limit">
    <description>Change clipboard panel history limit</description>
    <description xml:lang="es">Cambiar el máximo del historial del panel del portapapeles</description>
    <message>Changing the clipboard history limit requires your password</message>
    <message xml:lang="es">Cambiar el máximo del historial del portapapeles requiere tu contraseña</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_self</allow_active>
    </defaults>
  </action>
</policyconfig>
